          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Scanner konnte die Seite nicht erfassen. Versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El escáner no ha podido capturar la página. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scanner n'a pas pu capturer la page. Réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo scanner non è riuscito ad acquisire la pagina. Riprova."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skaner nie zarejestrował strony. Spróbuj ponownie."
          }
        }
      }
    },
    "The score knows nothing about stress, alcohol, medication or crossing time zones — only about their traces in the signals. If it says you are ready and you feel broken, trust yourself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wert weiß nichts von Stress, Alkohol, Medikamenten oder Zeitzonenwechseln — nur von ihren Spuren in den Signalen. Wenn er sagt, du bist bereit, und du fühlst dich kaputt, vertrau dir selbst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La puntuación no sabe nada del estrés, el alcohol, la medicación ni los cambios de huso horario — solo de su rastro en las señales. Si dice que estás a punto y te sientes sin fuerzas, fíate de ti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le score ignore tout du stress, de l'alcool, des médicaments ou du décalage horaire — il n'en connaît que les traces dans les signaux. S'il indique que vous êtes en forme alors que vous vous sentez à plat, fiez-vous à vos sensations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il punteggio non sa nulla di stress, alcol, farmaci o cambi di fuso orario — solo delle loro tracce nei segnali. Se dice che sei pronto e ti senti a pezzi, fidati di te."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wynik nic nie wie o stresie, alkoholu, lekach ani podróży przez strefy czasowe — zna tylko ich ślady w sygnałach. Jeśli mówi, że jesteś gotowy, a czujesz się rozbity, zaufaj sobie."
          }
        }
      }
    },
    "The server did not finish the erase. Nothing is assumed gone — try again in a moment." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat das Löschen nicht abgeschlossen. Nichts gilt als gelöscht — versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor no terminó el borrado. No damos nada por borrado: inténtalo de nuevo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur n’a pas terminé la suppression. Rien n’est considéré comme supprimé — réessayez dans un instant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server non ha completato l’eliminazione. Nulla è considerato eliminato: riprova tra un momento."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serwer nie dokończył usuwania. Nic nie uznajemy za skasowane — spróbuj ponownie za chwilę."
          }
        }
      }
    },
    "The service is not responding right now. Try again in a few minutes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dienst antwortet gerade nicht. Versuche es in ein paar Minuten erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio no responde ahora mismo. Inténtalo en unos minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le service ne répond pas pour le moment. Réessayez dans quelques minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il servizio al momento non risponde. Riprova tra qualche minuto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usługa chwilowo nie odpowiada. Spróbuj za kilka minut."
          }
        }
      }
    },
    "The women's load is heavier than the men's." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Last der Frauen ist höher als die der Männer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carga de mujeres es mayor que la de hombres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La charge femmes est plus lourde que la charge hommes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il carico delle donne è più pesante di quello degli uomini."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obciążenie dla kobiet jest większe niż dla mężczyzn."
          }
        }
      }
    },
    "The workout is still running on the watch. End it on Apple Watch by holding the Stop button." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Training läuft auf der Watch noch. Beende es auf der Apple Watch, indem du die Stopp-Taste gedrückt hältst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El entrenamiento sigue activo en el reloj. Termínalo en el Apple Watch manteniendo pulsado el botón Detener."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entraînement est toujours en cours sur la montre. Terminez-le sur l'Apple Watch en maintenant le bouton Stop."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'allenamento è ancora in corso sull'orologio. Terminalo su Apple Watch tenendo premuto il pulsante Stop."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trening nadal trwa na zegarku. Zakończ go na Apple Watch, przytrzymując przycisk Stop."
          }
        }
      }
    },
    "The workout will be permanently deleted from HealthKit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Training wird endgültig aus HealthKit gelöscht."
          }
        },
        "es" : {
