    },
    "You haven’t scheduled any workouts yet." : {
      "extractionState" : "stale",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie zaplanowano jeszcze żadnych treningów."
          }
        }
      }
    },
    "You'll share a .txt file with the unrecognized exercise names and their occurrence counts — no workout data included." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartirás un archivo .txt con los nombres de ejercicios no reconocidos y el número de veces que aparecen — sin datos de entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous partagerez un fichier .txt contenant les noms d'exercices non reconnus et leur nombre d'occurrences — sans aucune donnée d'entraînement."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udostępnisz plik .txt z nazwami nierozpoznanych ćwiczeń i liczbą wystąpień — bez żadnych danych treningowych."
          }
        }
      }
    },
    "You're already in this group." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya estás en este grupo."
