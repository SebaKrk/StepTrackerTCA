    "Erases your results, group memberships and account from our server. Workouts in the Health app and plans on this iPhone stay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht deine Ergebnisse, Gruppenmitgliedschaften und dein Konto von unserem Server. Trainings in der Health-App und Pläne auf diesem iPhone bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra tus resultados, tus grupos y tu cuenta de nuestro servidor. Los entrenamientos de la app Salud y los planes de este iPhone se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface vos résultats, vos appartenances aux groupes et votre compte de notre serveur. Les entraînements de l’app Santé et les plans de cet iPhone sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina i tuoi risultati, le iscrizioni ai gruppi e l’account dal nostro server. Gli allenamenti nell’app Salute e i piani su questo iPhone restano."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa Twoje wyniki, członkostwa w grupach i konto z naszego serwera. Treningi w aplikacji Zdrowie i plany na tym iPhonie zostają."
          }
        }
      }
    },
