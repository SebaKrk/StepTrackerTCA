    },
    "The workout will be removed from HealthKit and won't be saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Training wird aus HealthKit entfernt und nicht gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El entrenamiento se quitará de HealthKit y no se guardará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entraînement sera supprimé de HealthKit et ne sera pas enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'allenamento verrà rimosso da HealthKit e non verrà salvato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trening zostanie usunięty z HealthKit i nie zostanie zapisany."
          }
        }
      }
    },
    "These figures are indicative. They are not a diagnosis and not medical advice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Werte dienen der Orientierung. Sie sind keine Diagnose und kein medizinischer Rat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas cifras son orientativas. No son un diagnóstico ni un consejo médico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces chiffres sont fournis à titre indicatif. Ils ne constituent ni un diagnostic ni un avis médical."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi valori sono indicativi. Non sono una diagnosi né un parere medico."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To dane poglądowe. Nie są diagnozą ani poradą medyczną."
          }
        }
      }
    },
    "They lose access to the group; their results stay on the board. Open invite codes are closed, so show a new one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Person verliert den Zugriff auf die Gruppe; ihre Ergebnisse bleiben am Board. Offene Einladungscodes werden geschlossen, zeige also einen neuen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierde el acceso al grupo; sus resultados se quedan en la pizarra. Los códigos de invitación abiertos se cierran, así que muestra uno nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette personne perd l'accès au groupe ; ses résultats restent au tableau. Les codes d'invitation ouverts sont fermés : montrez-en un nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perde l'accesso al gruppo; i suoi risultati restano sul tabellone. I codici di invito aperti vengono chiusi, quindi mostrane uno nuovo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Straci dostęp do grupy, wyniki zostaną na tablicy. Otwarte kody zaproszeń zostaną zamknięte, pokaż nowy."
          }
        }
      }
    },
    "This block has no movements." : {
      "localizations" : {
