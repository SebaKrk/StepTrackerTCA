      }
    },
    "50 means every signal sits at your usual level. That is normal, not a warning. Above 50 you are better recovered than usual, below it — less." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50 heißt: Jedes Signal liegt auf deinem üblichen Niveau. Das ist normal, keine Warnung. Über 50 bist du besser erholt als sonst, darunter — weniger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50 significa que todas las señales están en tu nivel habitual. Es lo normal, no una advertencia. Por encima de 50, tu recuperación es mejor de lo habitual; por debajo — peor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50 signifie que chaque signal se situe à votre niveau habituel. C'est normal, ce n'est pas une alerte. Au-dessus de 50, vous avez mieux récupéré que d'habitude, en dessous — moins bien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50 significa che ogni segnale è al tuo livello abituale. È normale, non un avviso. Sopra 50 hai recuperato meglio del solito, sotto — meno."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50 oznacza, że każdy sygnał jest na Twoim zwykłym poziomie. To stan normalny, nie ostrzeżenie. Powyżej 50 jesteś lepiej wyregenerowany niż zwykle, poniżej — gorzej."
          }
        }
      }
    },
