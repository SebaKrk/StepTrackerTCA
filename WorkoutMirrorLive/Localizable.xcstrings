    "Members can enter a result for each block that is on. Effort points rank everyone either way." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitglieder können für jeden aktivierten Block ein Ergebnis eintragen. Effort Points reihen so oder so alle ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los miembros pueden introducir un resultado por cada bloque activado. Los puntos de esfuerzo clasifican a todos igualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les membres peuvent saisir un résultat pour chaque bloc activé. Dans tous les cas, les points d'effort classent tout le monde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I membri possono inserire un risultato per ogni blocco attivo. I punti sforzo mettono comunque tutti in classifica."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla każdego włączonego bloku można wpisać wynik. Punkty wysiłku i tak ustawiają wszystkich w tabeli."
          }
        }
      }
    },
    "Members have already posted results for this plan. They will be deleted with it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitglieder haben für diesen Plan bereits Ergebnisse eingetragen. Sie werden mit ihm gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los miembros ya han publicado resultados de este plan. Se eliminarán con él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des membres ont déjà publié des résultats pour ce plan. Ils seront supprimés avec lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I membri hanno già pubblicato risultati per questo piano. Verranno eliminati insieme al piano."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Członkowie wpisali już wyniki do tego planu. Zostaną usunięte razem z nim."
          }
        }
      }
    },
    "Members see your name and your results for this group's plans — nothing else from your health data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitglieder sehen deinen Namen und deine Ergebnisse zu den Plänen dieser Gruppe — sonst nichts aus deinen Gesundheitsdaten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los miembros ven tu nombre y tus resultados en los planes de este grupo — nada más de tus datos de salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les membres voient votre nom et vos résultats pour les plans de ce groupe — rien d'autre de vos données de santé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I membri vedono il tuo nome e i tuoi risultati nei piani di questo gruppo — nient'altro dei tuoi dati sanitari."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Członkowie widzą Twoje imię i wyniki z planów tej grupy — nic więcej z Twoich danych zdrowotnych."
          }
        }
      }
    },
