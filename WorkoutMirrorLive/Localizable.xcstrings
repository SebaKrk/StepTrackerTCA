    "The key is stored securely in the device's Keychain." : {
      "extractionState" : "stale",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klucz jest przechowywany bezpiecznie w Keychain urządzenia."
