    },
    "That is separate from history: on first launch the app rebuilds 60 days of results from Apple Health, so the trend chart means something straight away." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto es independiente del historial: en el primer arranque, la app reconstruye 60 días de resultados desde Salud, así que el gráfico de tendencia tiene sentido desde el principio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C'est distinct de l'historique : au premier lancement, l'app reconstitue 60 jours de résultats à partir de Santé, pour que le graphique de tendance soit parlant tout de suite."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To co innego niż historia: przy pierwszym uruchomieniu aplikacja odtwarza z Apple Health 60 dni wyników, więc wykres trendu ma sens od razu."
          }
        }
      }
    },
    "the alternatives" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "las alternativas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "les alternatives"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "alternatywy"
          }
        }
      }
    },
    "The bundle describes the app only — versions, migrations and row counts. No training data leaves the device." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El paquete solo describe la app — versiones, migraciones y recuento de filas. Ningún dato de entrenamiento sale del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le paquet ne décrit que l'app — versions, migrations et nombres de lignes. Aucune donnée d'entraînement ne quitte l'appareil."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paczka opisuje wyłącznie aplikację — wersje, migracje i liczby wierszy. Żadne dane treningowe nie opuszczają urządzenia."
          }
        }
      }
    },
    "The bundle will carry your full training history and your profile." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El paquete incluirá todo tu historial de entrenamiento y tu perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le paquet contiendra tout votre historique d'entraînement et votre profil."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paczka będzie zawierać całą Twoją historię treningową i profil."
          }
        }
      }
    },
    "The cap is not a whole number of %lld s intervals." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El límite no es un número entero de intervalos de %lld s."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps limite n'est pas un multiple entier d'intervalles de %lld s."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limit nie jest wielokrotnością interwału %lld s."
          }
        }
      }
    },
    "The code expired or was revoked. Ask for a new one." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El código ha caducado o se ha revocado. Pide uno nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le code a expiré ou a été révoqué. Demandez-en un nouveau."
          }
