    },
    "Your completed workouts will appear here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecerán tus entrenamientos completados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos entraînements terminés apparaîtront ici."
