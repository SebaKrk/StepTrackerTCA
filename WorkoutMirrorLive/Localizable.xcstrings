    "%@ will manage the group. You stay as a member." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gestionará el grupo. Tú seguirás como miembro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gérera le groupe. Vous restez membre."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ będzie zarządzać grupą. Ty zostajesz jako członek."
          }
        }
      }
    },
    "%@, the longest-standing member, becomes the owner. You can come back only with a new invite." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, el miembro más antiguo, pasará a ser el propietario. Solo podrás volver con una nueva invitación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, membre le plus ancien, devient propriétaire. Vous ne pourrez revenir qu'avec une nouvelle invitation."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Właścicielem zostanie %@, najdłużej w grupie. Wrócić możesz tylko z nowym zaproszeniem."
          }
        }
      }
    },
