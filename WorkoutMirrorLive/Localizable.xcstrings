    "Effort counts the first %lld minutes from the workout start." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effort zählt die ersten %lld Minuten ab Trainingsstart."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El esfuerzo cuenta los primeros %lld minutos desde el inicio del entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'effort est compté sur les %lld premières minutes à partir du début de l'entraînement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo sforzo conta i primi %lld minuti dall'inizio dell'allenamento."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysiłek liczony jest z pierwszych %lld minut od startu treningu."
          }
        }
      }
    },
    "Effort Points" : {
      "localizations" : {
        "de" : {
