    },
    "The bundle describes the app — versions, migrations and row counts — and carries your workout logs, heart rate included." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Paket beschreibt die App – Versionen, Migrationen und Zeilenanzahlen – und enthält deine Trainingsprotokolle einschließlich Herzfrequenz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El paquete describe la app (versiones, migraciones y número de filas) e incluye tus registros de entrenamiento, con la frecuencia cardiaca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le paquet décrit l’app — versions, migrations et nombres de lignes — et contient vos journaux d’entraînement, fréquence cardiaque comprise."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pacchetto descrive l’app — versioni, migrazioni e numero di righe — e contiene i tuoi log di allenamento, frequenza cardiaca inclusa."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paczka opisuje aplikację — wersje, migracje i liczby wierszy — oraz zawiera Twoje logi treningu, razem z tętnem."
          }
        }
      }
    },
    "The bundle describes the app only — versions, migrations and row counts. No training data leaves the device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Paket beschreibt nur die App — Versionen, Migrationen und Zeilenanzahlen. Keine Trainingsdaten verlassen das Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El paquete solo describe la app — versiones, migraciones y recuento de filas. Ningún dato de entrenamiento sale del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le paquet ne décrit que l'app — versions, migrations et nombres de lignes. Aucune donnée d'entraînement ne quitte l'appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pacchetto descrive solo l'app — versioni, migrazioni e numero di righe. Nessun dato di allenamento lascia il dispositivo."
          }
        },
        "pl" : {
          "stringUnit" : {
