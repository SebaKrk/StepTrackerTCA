        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod wygasł albo został unieważniony. Poproś o nowy."
          }
        }
      }
    },
    "The entry was not deleted. Please try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La entrada no se ha eliminado. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'entrée n'a pas été supprimée. Veuillez réessayer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpis nie został usunięty. Spróbuj ponownie."
          }
        }
      }
    },
    "The group data could not be read." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido leer los datos del grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire les données du groupe."
