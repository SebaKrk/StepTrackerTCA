    "Unlock insights into your training. Visualize your progress, heart rate zones, and performance trends over time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte Einblicke in dein Training. Visualisiere deinen Fortschritt, deine Herzfrequenzzonen und Leistungstrends im Zeitverlauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descubre las claves de tu entrenamiento. Visualiza tu progreso, tus zonas de frecuencia cardiaca y la evolución de tu rendimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accédez à des analyses détaillées de votre entraînement. Visualisez votre progression, vos zones de fréquence cardiaque et l'évolution de vos performances."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scopri di più sui tuoi allenamenti. Visualizza i progressi, le zone di frequenza cardiaca e le tendenze delle prestazioni nel tempo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odkryj szczegółowe informacje o swoim treningu. Wizualizuj swoje postępy, strefy tętna oraz trendy wydajności na przestrzeni czasu."
          }
        }
      }
    },
