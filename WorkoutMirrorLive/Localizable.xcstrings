    "\"%@\" and all its exercises will be removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ und alle zugehörigen Übungen werden entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán “%@” y todos sus ejercicios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » et tous ses exercices seront supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" e tutti i suoi esercizi verranno rimossi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@\" i wszystkie jego ćwiczenia zostaną usunięte."
          }
        }
      }
    },
    "\"%@\" and all its workouts will be permanently removed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ und alle zugehörigen Trainings werden endgültig entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” y todos sus entrenamientos se eliminarán de forma permanente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » et tous ses entraînements seront définitivement supprimés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" e tutti i suoi allenamenti verranno rimossi definitivamente."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@\" i wszystkie jego treningi zostaną trwale usunięte."
          }
        }
      }
    },
    "\"%@\" is not in the exercise catalog — it will be saved under that name." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist nicht im Übungskatalog — wird unter diesem Namen gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no está en el catálogo de ejercicios — se guardará con ese nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ne figure pas dans le catalogue d'exercices — il sera enregistré sous ce nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" non è nel catalogo esercizi — verrà salvato con questo nome."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” nie ma w katalogu ćwiczeń. Zostanie zapisane pod tą nazwą."
          }
        }
      }
    },
    "\"%@\" will be removed from this workout." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird aus diesem Training entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” se quitará de este entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera retiré de cet entraînement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" verrà rimosso da questo allenamento."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@\" zostanie usunięte z tego treningu."
          }
        }
      }
