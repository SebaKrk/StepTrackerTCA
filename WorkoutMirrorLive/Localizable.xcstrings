    "Changing the formula won't affect saved workouts — each workout keeps the formula from the moment it was saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Änderung der Formel wirkt sich nicht auf gesicherte Trainings aus — jedes Training behält die Formel vom Zeitpunkt des Sicherns."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar la fórmula no afecta a los entrenamientos guardados — cada uno conserva la fórmula del momento en que se guardó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changer de formule n'affecte pas les entraînements enregistrés — chacun conserve la formule en vigueur lors de son enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiare la formula non modifica gli allenamenti salvati — ogni allenamento mantiene la formula del momento in cui è stato salvato."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana formuły nie wpłynie na zapisane treningi — każdy trening zachowuje formułę z momentu zapisania."
          }
        }
      }
    },
    "Charts comparing your selected workouts will appear here." : {
