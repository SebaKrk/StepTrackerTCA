    "Today's plan was already published by %@. A group has one plan per day — publish first next time, or create a new group for yours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der heutige Plan wurde bereits von %@ veröffentlicht. Eine Gruppe hat einen Plan pro Tag — veröffentliche nächstes Mal zuerst oder erstelle eine neue Gruppe für deinen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya ha publicado el plan de hoy. Un grupo tiene un plan al día — la próxima vez publica antes, o crea un grupo nuevo para el tuyo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plan du jour a déjà été publié par %@. Un groupe a un seul plan par jour — publiez en premier la prochaine fois ou créez un nouveau groupe pour le vôtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il piano di oggi è già stato pubblicato da %@. Un gruppo ha un piano al giorno — la prossima volta pubblica per primo, o crea un nuovo gruppo per il tuo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ już opublikował(a) plan na dziś. Grupa ma jeden plan dziennie: następnym razem opublikuj pierwszy albo załóż nową grupę dla swojego."
          }
        }
      }
    },
