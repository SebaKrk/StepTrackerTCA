    "This device doesn't support Bluetooth Low Energy required by heart rate monitors" : {
      "extractionState" : "stale",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To urządzenie nie obsługuje Bluetooth Low Energy wymaganego przez monitory tętna"
          }
        }
      }
    },
    "This does not lower your readiness score: the score compares you against your own norm, and a norm that is too low cannot show up in that comparison." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das senkt deinen Bereitschaftswert nicht: Der Wert vergleicht dich mit deinem eigenen Basiswert, und ein zu niedriger Basiswert kann in diesem Vergleich nicht auffallen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto no baja tu puntuación de disposición: la puntuación te compara con tu propia norma, y una norma demasiado baja no puede reflejarse en esa comparación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela ne fait pas baisser votre score de préparation : le score vous compare à votre propre norme, et une norme trop basse ne peut pas apparaître dans cette comparaison."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo non abbassa il tuo punteggio di prontezza: il punteggio ti confronta con la tua norma, e una norma troppo bassa non può emergere da quel confronto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To nie obniża Twojego wyniku gotowości: wynik porównuje Cię do Twojej własnej normy, a zbyt niska norma nie może się w tym porównaniu ujawnić."
          }
        }
      }
    },
