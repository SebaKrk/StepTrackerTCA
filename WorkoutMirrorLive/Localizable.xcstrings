    "%@ will manage the group. You stay as a member." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ verwaltet dann die Gruppe. Du bleibst Mitglied."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gestionará el grupo. Tú seguirás como miembro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gérera le groupe. Vous restez membre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gestirà il gruppo. Tu resti come membro."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ będzie zarządzać grupą. Ty zostajesz jako członek."
          }
        }
      }
    },
    "%@, the longest-standing member, becomes the owner. You can come back only with a new invite." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist am längsten dabei und wird Inhaber. Zurück kommst du nur mit einer neuen Einladung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, el miembro más antiguo, pasará a ser el propietario. Solo podrás volver con una nueva invitación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, membre le plus ancien, devient propriétaire. Vous ne pourrez revenir qu'avec une nouvelle invitation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, il membro di più lunga data, diventa proprietario. Potrai tornare solo con un nuovo invito."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Właścicielem zostanie %@, najdłużej w grupie. Wrócić możesz tylko z nowym zaproszeniem."
          }
        }
      }
    },
