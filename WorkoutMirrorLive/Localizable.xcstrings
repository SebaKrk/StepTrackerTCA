          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desaparece para todos junto con sus planes y resultados. Las copias de los planes en Planes de los miembros se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il disparaît pour tout le monde, avec ses plans et ses résultats. Les copies des plans dans les Plans des membres sont conservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
