    "You are the only member, so the group is deleted with its plans and results." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eres el único miembro, así que el grupo se elimina junto con sus planes y resultados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes le seul membre : le groupe sera donc supprimé avec ses plans et ses résultats."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesteś jedynym członkiem, więc grupa zostanie usunięta razem z planami i wynikami."
          }
        }
      }
    },
    "You can come back only with a new invite." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo podrás volver con una nueva invitación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pourrez revenir qu'avec une nouvelle invitation."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wrócić możesz tylko z nowym zaproszeniem."
          }
        }
      }
    },
    "You can join %@ later only by scanning the code again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más adelante solo podrás unirte a %@ escaneando de nuevo el código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pourrez rejoindre %@ plus tard qu'en scannant à nouveau le code."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do grupy %@ dołączysz później tylko po ponownym zeskanowaniu kodu."
          }
        }
      }
    },
    "You can now start scanning for Bluetooth devices" : {
      "extractionState" : "stale",
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz teraz rozpocząć skanowanie urządzeń Bluetooth"
          }
        }
      }
    },
    "You can scan two plans a day. The next scan is available at %@." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes escanear dos planes al día. El próximo escaneo estará disponible a las %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez scanner deux plans par jour. Le prochain scan sera disponible à %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziennie możesz zeskanować dwa plany. Następny skan będzie dostępny o %@."
          }
        }
      }
    },
    "You can scan two plans a day. The next scan is available tomorrow." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
