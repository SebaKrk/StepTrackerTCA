          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odczytać danych grupy."
          }
        }
      }
    },
    "The group plan isn't available — the result stays only on this phone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El plan del grupo no está disponible — el resultado se queda solo en este teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le plan du groupe n'est pas disponible — le résultat reste uniquement sur ce téléphone."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan grupy jest niedostępny — wynik zostanie tylko na tym telefonie."
          }
        }
      }
    },
    "The group sees the whole plan and can download it to their Plans." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El grupo ve el plan completo y puede descargarlo en sus Planes."
          }
        },
