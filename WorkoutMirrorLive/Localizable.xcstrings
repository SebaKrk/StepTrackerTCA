    "The block and its movements will be removed from the cool-down." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Block und seine Übungen werden aus dem Cool-down entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bloque y sus ejercicios se quitarán de la vuelta a la calma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bloc et ses mouvements seront retirés du retour au calme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il blocco e i suoi esercizi verranno rimossi dal defaticamento."
          }
        },
        "pl" : {
          "stringUnit" : {
