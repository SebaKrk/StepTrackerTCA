    "Rep ladder and round count were both written — the ladder was kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wdh.-Leiter und Rundenzahl waren beide notiert — die Leiter wurde behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Había escalera de reps y número de rondas — se ha conservado la escalera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une échelle de répétitions et un nombre de tours étaient tous deux indiqués — l'échelle a été conservée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono stati scritti sia la scala di ripetizioni sia il numero di round — è stata mantenuta la scala."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisano drabinkę i liczbę rund naraz. Zostawiono drabinkę."
          }
        }
      }
    },
    "Repeating the same scan will not help. Add the plan manually for now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denselben Scan zu wiederholen hilft nicht. Füge den Plan vorerst manuell hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repetir el mismo escaneo no servirá. Por ahora, añade el plan manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répéter le même scan ne changera rien. Pour l'instant, ajoutez le plan manuellement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripetere la stessa scansione non servirà. Per ora aggiungi il piano manualmente."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
