      }
    },
    "A single number from 0 to 100 saying how much your body can take today. It compares you against yourself, not against anyone else." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un único número de 0 a 100 que indica cuánto puede aguantar hoy tu cuerpo. Te compara contigo, no con nadie más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un seul chiffre de 0 à 100 qui indique ce que votre corps peut encaisser aujourd'hui. Il vous compare à vous-même, pas aux autres."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna liczba od 0 do 100, która mówi, ile organizm udźwignie dzisiaj. Porównuje Cię do Ciebie samego, nie do innych."
          }
        }
