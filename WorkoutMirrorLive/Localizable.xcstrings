        }
      }
    },
    "Effort points and kcal summed Monday to Sunday — every workout counts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effort Points und kcal, summiert von Montag bis Sonntag — jedes Training zählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puntos de esfuerzo y kcal sumados de lunes a domingo — cada entrenamiento cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Points d'effort et kcal cumulés du lundi au dimanche — chaque entraînement compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punti sforzo e kcal sommati da lunedì a domenica — ogni allenamento conta."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suma punktów i kcal od poniedziałku do niedzieli — liczy się każdy trening."
          }
        }
      }
    },
    "Effort points count from each member's start for this long — the same window for the whole group. The plan itself is published unchanged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effort Points zählen ab dem Start jedes Mitglieds so lange — dasselbe Fenster für die ganze Gruppe. Der Plan selbst wird unverändert veröffentlicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los puntos de esfuerzo cuentan durante este tiempo desde el inicio de cada miembro — la misma ventana para todo el grupo. El plan se publica sin cambios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les points d'effort sont comptés pendant cette durée à partir du départ de chaque membre — la même fenêtre pour tout le groupe. Le plan lui-même est publié tel quel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I punti sforzo si contano per questa durata dall'inizio di ogni membro — la stessa finestra per tutto il gruppo. Il piano viene pubblicato senza modifiche."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punkty liczą się przez tyle minut od startu każdej osoby — to samo okno dla całej grupy. Sam plan publikujemy bez zmian."
          }
        }
      }
    },
