      }
    },
    "The leaderboard loads once you are back online." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clasificación se cargará cuando vuelvas a tener conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le classement se chargera dès que vous serez de nouveau en ligne."
          }
        },
