<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<!-- fetch: recalculates training readiness so the widget is not stale (ReadinessRefreshScheduler) -->
		<string>fetch</string>
		<!-- bluetooth-central: reads the heart-rate strap and writes heart rate to the coach's iPad with the screen off -->
		<string>bluetooth-central</string>
		<!-- location: records the route of an outdoor workout with the screen off (WorkoutRouteRecorder) -->
		<string>location</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>ss.WorkoutMirrorLive.readinessRefresh</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
</dict>
</plist>
