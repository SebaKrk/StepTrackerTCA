# Development ceiling: a runaway loop here costs a few zloty, not a few hundred.
GLOBAL_DAILY_CALLS=50

# Lets the DEBUG build compare models on a real board; production has no such file.
ALLOW_MODEL_OVERRIDE=true

# Logs whole plan-chat turns so a wrong correction can be traced; never set in production.
LOG_REFINE_CONTENT=true

# Logs what each scan read off the board and the board it built (never the photo); never set in production.
LOG_SCAN_CONTENT=true
