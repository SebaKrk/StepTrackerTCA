    "Activity Level" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivitätsniveau"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nivel de actividad"
          }
        },
        "fr" : {
          "stringUnit" : {
