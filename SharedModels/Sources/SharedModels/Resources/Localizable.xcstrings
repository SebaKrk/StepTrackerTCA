    "Stop Timer" : {

    },
    "Strength" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trening siłowy"
          }
        }
      }
    },
    "Strength Training" : {
      "localizations" : {
        "pl" : {
          "stringUnit" : {
