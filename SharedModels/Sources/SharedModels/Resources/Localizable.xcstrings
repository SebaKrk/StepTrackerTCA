    "Resting Heart Rate" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruhepuls"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frecuencia cardiaca en reposo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fréquence cardiaque au repos"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequenza cardiaca a riposo"
          }
        },
        "pl" : {
