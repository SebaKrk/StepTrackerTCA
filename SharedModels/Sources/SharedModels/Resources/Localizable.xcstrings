    },
    "HR Recovery" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperación de FC"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupération FC"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeneracja tętna"
          }
        }
      }
    },
    "HR Recovery measures how many beats per minute (bpm) your heart rate drops in the first minute after stopping exercise.\n\nFaster recovery indicates better cardiovascular fitness and a more responsive autonomic nervous system.\n\nFormula:\nHR Recovery = Max HR during workout − HR after 1 minute\n\nTypical values:\n• < 12 bpm: Poor\n• 12–20 bpm: Average\n• 20–30 bpm: Good\n• 30–40 bpm: Very Good\n• > 40 bpm: Excellent" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación de FC mide cuántos latidos por minuto (bpm) baja tu frecuencia cardiaca en el primer minuto tras parar el ejercicio.\n\nUna recuperación más rápida indica mejor forma cardiovascular y un sistema nervioso autónomo más reactivo.\n\nFórmula:\nRecuperación de FC = FC máx. durante el entrenamiento − FC tras 1 minuto\n\nValores típicos:\n• < 12 bpm: Baja\n• 12–20 bpm: Media\n• 20–30 bpm: Buena\n• 30–40 bpm: Muy buena\n• > 40 bpm: Excelente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La récupération FC mesure de combien de battements par minute (bpm) votre fréquence cardiaque baisse dans la première minute après l'arrêt de l'effort.\n\nUne récupération plus rapide indique une meilleure forme cardiovasculaire et un système nerveux autonome plus réactif.\n\nFormule :\nRécupération FC = FC max pendant l'entraînement − FC après 1 minute\n\nValeurs typiques :\n• < 12 bpm : Faible\n• 12–20 bpm : Moyenne\n• 20–30 bpm : Bonne\n• 30–40 bpm : Très bonne\n• > 40 bpm : Excellente"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regeneracja Tętna mierzy o ile uderzeń na minutę (bpm) spada Twoje tętno w pierwszej minucie po zakończeniu ćwiczeń.\n\nSzybsza regeneracja wskazuje na lepszą sprawność układu krążenia i bardziej responsywny układ autonomiczny.\n\nWzór:\nRegeneracja Tętna = Maks. tętno podczas treningu − Tętno po 1 minucie\n\nTypowe wartości:\n• < 12 bpm: Słaba\n• 12–20 bpm: Przeciętna\n• 20–30 bpm: Dobra\n• 30–40 bpm: Bardzo dobra\n• > 40 bpm: Doskonała"
          }
        }
      }
    },
    "hrTSS" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "hrTSS"
          }
        },
