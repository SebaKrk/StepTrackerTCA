    },
    "Sleep Quality" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calidad del sueño"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualité du sommeil"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakość snu"
          }
        }
      }
    },
    "Sleep quality is scored from time spent in the sleep stages (deep, REM, light). Better sleep improves recovery and training readiness. 7–9 hours are recommended for adults." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La calidad del sueño se puntúa según el tiempo en cada fase del sueño (profundo, REM, ligero). Dormir mejor mejora la recuperación y la disposición para entrenar. Para adultos se recomiendan 7–9 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La qualité du sommeil est évaluée d'après le temps passé dans les phases de sommeil (profond, paradoxal, léger). Un meilleur sommeil améliore la récupération et la préparation à l'entraînement. 7 à 9 heures sont recommandées pour les adultes."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jakość snu oceniana jest na podstawie czasu spędzonego w różnych fazach snu (głęboki, REM, lekki). Lepszy sen przyczynia się do lepszej regeneracji i gotowości treningowej. Zalecane 7-9 godzin dla dorosłych."
          }
        }
      }
    },
    "Slow heart rate recovery. May indicate fatigue or stress." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperación lenta de la frecuencia cardiaca. Puede indicar fatiga o estrés."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupération lente de la fréquence cardiaque. Peut indiquer de la fatigue ou du stress."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powolny spadek tętna. Może wskazywać na zmęczenie lub stres."
          }
        }
      }
    },
