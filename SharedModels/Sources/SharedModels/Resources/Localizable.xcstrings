    "Significant stress. Consider 1-2 days of easy training." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhebliche Belastung. Erwäge 1-2 Tage lockeres Training."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrés considerable. Plantéate 1-2 días de entrenamiento suave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress important. Envisagez 1-2 jours d'entraînement léger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress significativo. Valuta 1-2 giorni di allenamento leggero."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znaczny stres. Rozważ 1-2 dni lekkiego treningu."
          }
        }
      }
    },
    "Sleep" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
