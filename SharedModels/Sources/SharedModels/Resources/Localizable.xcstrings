    },
    "Very demanding session. Full recovery may take 3+ days." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehr fordernde Einheit. Die vollständige Erholung kann 3+ Tage dauern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesión muy exigente. La recuperación completa puede llevar 3 días o más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séance très exigeante. La récupération complète peut prendre 3 jours ou plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
