{
  "sourceLanguage" : "en",
  "strings" : {
    "NSHealthShareUsageDescription" : {
      "comment" : "Health read prompt on Apple Watch.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir lesen deine Herzfrequenz auf der Apple Watch, um sie während des Trainings anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We read your heart rate on Apple Watch to show it during your workout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leemos tu frecuencia cardíaca en el Apple Watch para mostrarla durante el entrenamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous lisons votre fréquence cardiaque sur l’Apple Watch pour l’afficher pendant l’entraînement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggiamo la tua frequenza cardiaca su Apple Watch per mostrarla durante l’allenamento."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czytamy Twoje tętno z Apple Watch, żeby pokazać je podczas treningu."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Health write prompt on Apple Watch.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir speichern deine abgeschlossenen Trainings (Herzfrequenz, Kalorien, Dauer) in der Health-App, damit dein Verlauf an einem Ort bleibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We save your completed workouts (heart rate, calories, duration) to the Health app, so your history stays in one place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardamos tus entrenamientos completados (frecuencia cardíaca, calorías, duración) en la app Salud, para que tu historial esté en un solo lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous enregistrons vos entraînements terminés (fréquence cardiaque, calories, durée) dans l’app Santé, pour que votre historique reste au même endroit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salviamo gli allenamenti completati (frequenza cardiaca, calorie, durata) nell’app Salute, così il tuo storico resta in un unico posto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisujemy ukończone treningi (tętno, kalorie, czas trwania) do aplikacji Zdrowie, żeby Twoja historia była w jednym miejscu."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Location prompt: the route of an outdoor workout.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei einem Training im Freien wird dein Standort verwendet, um Tempo und Distanz zu messen und die Route aufzuzeichnen, die in der Zusammenfassung angezeigt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During an outdoor workout your location is used to measure speed and distance and to record the route shown in the summary."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante un entrenamiento al aire libre, tu ubicación se usa para medir la velocidad y la distancia y para guardar la ruta que se muestra en el resumen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant un entraînement en extérieur, votre position sert à mesurer la vitesse et la distance et à enregistrer l’itinéraire affiché dans le résumé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante un allenamento all’aperto la tua posizione viene usata per misurare velocità e distanza e per registrare il percorso mostrato nel riepilogo."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas treningu na świeżym powietrzu Twoja lokalizacja służy do pomiaru prędkości i dystansu oraz do zapisania trasy widocznej w podsumowaniu."
          }
        }
      }
    }
  },
  "version" : "1.0"
}