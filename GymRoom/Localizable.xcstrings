    "End time will be set to now. Athletes still active will be finalized." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La hora de fin se fijará en este momento. Se cerrarán los datos de los atletas aún activos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'heure de fin sera définie sur maintenant. Les athlètes encore actifs seront clôturés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ora di fine verrà impostata su adesso. Gli atleti ancora attivi verranno chiusi."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czas zakończenia zostanie ustawiony na teraz. Aktywni zawodnicy zostaną sfinalizowani."
          }
        }
      }
    },
